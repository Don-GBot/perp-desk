# Copy to .env, uncomment the three key lines and fill them in. .env is git-ignored.
# Blofin API key: READ + TRADE permission only. No TRANSFER, no withdrawals. Bind it to your IP.
# BLOFIN_API_KEY=
# BLOFIN_API_SECRET=
# BLOFIN_PASSPHRASE=

# Optional overrides
# DATA_DIR=./data
# BOT_CONFIG=./config.yaml
